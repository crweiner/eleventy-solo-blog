---
layout: base.njk
title: Home
description: Welcome to my Eleventy blog
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-image">
      <img src="/assets/images/chandler-weiner.jpg" alt="Chandler Weiner">
    </div>
    <div class="hero-content">
      <h1>Hey there 👋 I'm {{ site.title }}, a {{ site.description | lower }}</h1>
      <p>Showcase your work to your growing audience. Readers can subscribe below to receive the latest posts directly in their inbox 📬</p>
      <div class="profile-bio">
        <p>Welcome to my personal blog! I share my thoughts on technology, science, travel, and occasionally my love for tea.</p>
        <p>Check out my <a href="{{ site.social.github }}">GitHub</a> and <a href="{{ site.social.twitter }}">Twitter</a> to connect with me.</p>
      </div>

      <!-- Email Subscription Form -->
      <form class="subscribe-form" data-netlify="true" name="subscribe" method="POST" action="/thank-you">
        <input type="hidden" name="form-name" value="subscribe">
        <div class="form-group">
          <input type="email" name="email" id="email" placeholder="jamie@example.com" required>
          <button type="submit" class="subscribe-button">
            <span class="subscribe-icon">📮</span>
            Subscribe
          </button>
        </div>
        <p class="form-note">No spam, unsubscribe at any time.</p>
      </form>
    </div>
  </div>
</section>

<section class="recent-posts">
  <h2>Recent Writing</h2>
  
  {% if collections.posts %}
    <ul class="post-list">
      {% for post in collections.posts | reverse | limit(3) %}
        <li class="post-item">
          {% if post.data.featured_image %}
          <div class="post-image">
            <a href="{{ post.url }}">
              <img src="{{ post.data.featured_image }}" alt="{{ post.data.title }}">
            </a>
          </div>
          {% endif %}
          <div class="post-content-wrapper">
            <h3 class="post-title">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h3>
            <div class="post-meta">
              <time datetime="{{ post.date | w3DateFilter }}">{{ post.date | readableDate }}</time>
            </div>
            {% if post.data.excerpt %}
              <div class="post-excerpt">
                <p>{{ post.data.excerpt }}</p>
              </div>
            {% endif %}
            <a href="{{ post.url }}" class="read-more">Continue reading →</a>
          </div>
        </li>
      {% endfor %}
    </ul>
    
    <p style="text-align: left; margin-top: 5rem;"><a href="/blog/">View all articles →</a></p>
  {% else %}
    <p>No posts yet. Check back soon!</p>
  {% endif %}
</section>
